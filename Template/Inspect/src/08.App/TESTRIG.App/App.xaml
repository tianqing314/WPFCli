<Application
    x:Class="TESTRIG.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  1) Material Design 颜色主题：浅蓝主色（精确十六进制）  -->
                <materialDesign:CustomColorTheme
                    BaseTheme="Light"
                    PrimaryColor="#2F6FED"
                    SecondaryColor="#2F6FED" />
                <!--  2) MD2 控件默认样式（Card/Button/TextBox/DataGrid 等 style key 来源）  -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <!--  3) 本项目设计系统（颜色/字体字号/控件统一样式/标题栏）  -->
                <ResourceDictionary Source="pack://application:,,,/TESTRIG.UI.Shared;component/Theme/DesignSystem.xaml" />
                <!--  4) 板卡专属工具栏扩展的 VM→View 映射（测试运行页据此挑视图，页面本身不认识具体板卡）  -->
                <ResourceDictionary Source="pack://application:,,,/TESTRIG.UI.Shared;component/BoardExtras/BoardExtrasTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
