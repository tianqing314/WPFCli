<chrome:ChromeWindow
    x:Class="TESTRIG.UI.Shared.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:shell="clr-namespace:System.Windows;assembly=PresentationFramework"
    xmlns:views="clr-namespace:TESTRIG.UI.Shared.Views"
    xmlns:vm="clr-namespace:TESTRIG.UI.Shared.ViewModels"
    x:Name="Root"
    Title="TESTRIG 动态测试平台"
    Width="1280"
    Height="800"
    ShowCaptionButtons="False"
    Style="{StaticResource ChromeWindow.Style}"
    TitleIcon="MemoryArrowDown"
    WindowState="Maximized">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarProgressState}" ProgressValue="{Binding TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>
    <chrome:ChromeWindow.Resources>
        <DataTemplate DataType="{x:Type vm:TestRunViewModel}">
            <views:TestRunView />
        </DataTemplate>
    </chrome:ChromeWindow.Resources>

    <!--  ==================== 标题栏右侧：头像合并菜单 ====================  -->
    <chrome:ChromeWindow.TitleBarContent>
        <Grid>
            <ToggleButton
                x:Name="MenuTrigger"
                MinWidth="{Binding DataContext.TriggerMinWidth, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="Hand"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="bg"
                            Padding="6,4,10,4"
                            Background="#24FFFFFF"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            CornerRadius="3">
                            <!--  用 Grid 显式列（各列独立测量），规避标题栏内水平 StackPanel 非首子元素被测成 0 宽的问题  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="26"
                                    Height="26"
                                    Background="White"
                                    CornerRadius="3">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Brush.Primary}"
                                        Text="{Binding DataContext.UserInitial, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="9,0,6,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="{Binding DataContext.UserName, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}" />
                                <materialDesign:PackIcon
                                    Grid.Column="2"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Foreground="#DBFFFFFF"
                                    Kind="ChevronDown" />
                                <!--
                                    新版本红点（有可用更新时亮起）：贴头像右上角内侧。
                                    不要用负边距往外顶——按钮 Border 只有 4px 内边距 + 1px 描边，
                                    顶出去会被边框切掉一小块。
                                -->
                                <Ellipse
                                    Grid.Column="0"
                                    Width="8"
                                    Height="8"
                                    Margin="0,1,1,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="{StaticResource Brush.Danger}"
                                    Stroke="White"
                                    StrokeThickness="1"
                                    Visibility="{Binding DataContext.UpdateBadge, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Popup
                AllowsTransparency="True"
                HorizontalOffset="0"
                IsOpen="{Binding IsChecked, ElementName=MenuTrigger}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=MenuTrigger}"
                PopupAnimation="Fade"
                StaysOpen="False"
                VerticalOffset="6">
                <Border
                    Width="264"
                    Margin="10"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="20"
                            Direction="270"
                            Opacity="0.22"
                            ShadowDepth="3"
                            Color="#1E325A" />
                    </Border.Effect>
                    <StackPanel>
                        <!--  登录人  -->
                        <Border
                            Padding="16,14"
                            Background="{StaticResource Brush.PrimaryPale}"
                            BorderBrush="{StaticResource Brush.Divider}"
                            BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="40"
                                    Height="40"
                                    Background="{StaticResource Brush.Primary}"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding UserInitial}" />
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource Text.Body}"
                                        Text="{Binding UserName}" />
                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource Brush.PrimaryText}"
                                            Style="{StaticResource Text.Caption}"
                                            Text="本地测试账号" />
                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="7,1"
                                            Background="{StaticResource Brush.Primary}"
                                            CornerRadius="3"
                                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="White"
                                                Text="管理员" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  功能（仅显示已实现入口；均为管理员可见）  -->
                        <StackPanel Margin="6" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="10,6,0,4"
                                Foreground="{StaticResource Brush.TextMuted}"
                                Style="{StaticResource Text.Caption}"
                                Text="功能" />
                            <Button
                                HorizontalContentAlignment="Stretch"
                                Click="CloseMenu"
                                Command="{Binding OpenManualCommand}"
                                Style="{StaticResource DdItem}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Kind="BookOpenPageVariantOutline" />
                                    <TextBlock
                                        Margin="11,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="使用手册" />
                                </StackPanel>
                            </Button>
                            <Button
                                HorizontalContentAlignment="Stretch"
                                Click="CloseMenu"
                                Command="{Binding OpenManifestMaintenanceCommand}"
                                Style="{StaticResource DdItem}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Kind="ClipboardEditOutline" />
                                    <TextBlock
                                        Margin="11,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="TESTRIG / 测试项维护" />
                                </StackPanel>
                            </Button>
                            <Button
                                HorizontalContentAlignment="Stretch"
                                Click="CloseMenu"
                                Command="{Binding OpenCertificateCommand}"
                                Style="{StaticResource DdItem}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Kind="CertificateOutline" />
                                    <TextBlock
                                        Margin="11,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="证书 / 合格证" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--  在线升级：检查更新（红点提示新版本）+ 回滚到上一版本（有备份才显示）  -->
                        <StackPanel Margin="6,0,6,6">
                            <Button
                                HorizontalContentAlignment="Stretch"
                                Click="CloseMenu"
                                Command="{Binding CheckUpdateCommand}"
                                Style="{StaticResource DdItem}">
                                <DockPanel LastChildFill="False">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Kind="CloudDownloadOutline" />
                                    <TextBlock
                                        Margin="11,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Text="检查更新" />
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="8,0,2,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Fill="{StaticResource Brush.Danger}"
                                        Visibility="{Binding UpdateBadge, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </Button>
                            <Button
                                HorizontalContentAlignment="Stretch"
                                Click="CloseMenu"
                                Command="{Binding RollbackVersionCommand}"
                                Style="{StaticResource DdItem}"
                                Visibility="{Binding RollbackAvailable, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Kind="BackupRestore" />
                                    <TextBlock
                                        Margin="11,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="回滚到上一版本" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Brush.Divider}" />

                        <!--  注销登录（所有用户可见）：回到登录页重新登录  -->
                        <StackPanel Margin="6">
                            <Button
                                HorizontalContentAlignment="Stretch"
                                Click="OnLogout"
                                Style="{StaticResource DdItemDanger}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.Danger}"
                                        Kind="Power" />
                                    <TextBlock
                                        Margin="11,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="注销登录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Brush.Divider}" />

                        <!--  窗口控制  -->
                        <UniformGrid
                            Margin="6"
                            Columns="3"
                            Rows="1">
                            <Button
                                Margin="0,0,3,0"
                                Click="OnMinimize"
                                Style="{StaticResource DdWinButton}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Kind="WindowMinimize" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Text="最小化" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="3,0"
                                Click="OnMaximize"
                                Style="{StaticResource DdWinButton}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Kind="WindowMaximize" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Text="最大化" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="3,0,0,0"
                                Click="OnExit"
                                Style="{StaticResource DdWinButtonDanger}">
                                <StackPanel>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Kind="Close" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Text="退出" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </chrome:ChromeWindow.TitleBarContent>

    <DockPanel>
        <!--  底部状态栏：浅底 + 发丝上边线 + 等宽灰字 + 随窗底圆角  -->
        <Border
            Height="34"
            Padding="16,0"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Divider}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,5,5"
            DockPanel.Dock="Bottom">
            <DockPanel LastChildFill="False">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Success}"
                        Kind="Circle" />
                    <TextBlock
                        Margin="7,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font.Mono}"
                        FontSize="12"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text="{Binding StatusText}" />
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontFamily="{StaticResource Font.Mono}"
                    FontSize="12"
                    Foreground="{StaticResource Brush.TextMuted}"
                    Text="{Binding AppVersion, StringFormat='TESTRIG 动态测试平台 {0}'}" />
            </DockPanel>
        </Border>

        <!--  舞台：docked 抽屉 + 内容区，浮层抽屉/遮罩叠加在上  -->
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  docked 设备抽屉（未选板的入口态展开；选板后整列收起为 0）  -->
                <Border
                    Grid.Column="0"
                    Width="270"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.BorderStrong}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowDockedDrawer, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border Padding="14,13,14,11" DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource Brush.Primary}"
                                    Kind="ViewListOutline" />
                                <TextBlock
                                    Margin="9,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Subtitle}"
                                    Text="设备列表" />
                            </StackPanel>
                        </Border>
                        <views:DeviceTreeView />
                    </DockPanel>
                </Border>

                <!--
                    内容区：未选板显示入口空画布 + 最近使用；选板后显示 TestRunView。
                    入口画布放正常可视树用 Visibility 切换（不用 Content=null 的 ContentTemplate 承载——
                    ContentPresenter 会把 null DataContext 压进模板树，模板内 {Binding} 全部失效）
                -->
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding CurrentContent}" />

                    <!--  入口空画布  -->
                    <Grid Background="{StaticResource Brush.Bg}" Visibility="{Binding IsEntryVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel
                            MaxWidth="720"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border
                                Width="96"
                                Height="96"
                                HorizontalAlignment="Center"
                                Background="{StaticResource Brush.PrimaryPale}"
                                BorderBrush="#CFE0FC"
                                BorderThickness="1"
                                CornerRadius="6">
                                <materialDesign:PackIcon
                                    Width="46"
                                    Height="46"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource Brush.Primary}"
                                    Kind="ViewListOutline" />
                            </Border>
                            <TextBlock
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Text.Title}"
                                Text="选择设备开始测试" />
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource Brush.TextMuted}"
                                Style="{StaticResource Text.Body}"
                                Text="从左侧 设备 → 板子 选择，或点选下方最近使用" />

                            <!--  最近使用  -->
                            <StackPanel Margin="0,30,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Margin="2,0,0,10"
                                    Foreground="{StaticResource Brush.TextMuted}"
                                    Style="{StaticResource Text.Caption}"
                                    Text="最近使用" />
                                <ItemsControl ItemsSource="{Binding RecentBoards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BoardItemViewModel}">
                                            <!--  Style=x:Null：屏蔽 MaterialDesign 隐式 Button 样式（其 Height=32 会把卡片内容布局裁剪成一条线）  -->
                                            <Button
                                                Margin="6"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.OpenBoardCommand, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Style="{x:Null}"
                                                ToolTip="{Binding Description}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="rc"
                                                            Padding="14"
                                                            Background="{StaticResource Brush.Surface}"
                                                            BorderBrush="{StaticResource Brush.BorderStrong}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="rc" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel HorizontalAlignment="Left">
                                                    <Border
                                                        Padding="7,1"
                                                        HorizontalAlignment="Left"
                                                        Background="{StaticResource Brush.PrimaryPale}"
                                                        BorderBrush="#CFE0FC"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                        <TextBlock
                                                            FontFamily="{StaticResource Font.Mono}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource Brush.PrimaryText}"
                                                            Text="{Binding Device}" />
                                                    </Border>
                                                    <TextBlock
                                                        Margin="0,9,0,0"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource Brush.Text}"
                                                        Text="{Binding BoardName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,5,0,0"
                                                        FontSize="12"
                                                        Foreground="{StaticResource Brush.TextMuted}"
                                                        Text="{Binding Meta}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!--  遮罩：浮层抽屉打开时覆盖内容，点击关闭  -->
            <Border Background="#57142138" Visibility="{Binding IsDeviceDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding CloseDeviceDrawerCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
            </Border>

            <!--  浮层设备抽屉：选板后二次切换，滑出 + 不挤压布局  -->
            <Border
                Width="290"
                HorizontalAlignment="Left"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.BorderStrong}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsDeviceDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="-290" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.X"
                                                From="-290"
                                                To="0"
                                                Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="30"
                        Direction="0"
                        Opacity="0.25"
                        ShadowDepth="6"
                        Color="#14233F" />
                </Border.Effect>
                <DockPanel>
                    <Border
                        Padding="14,12"
                        Background="{StaticResource Brush.PrimaryPale}"
                        BorderBrush="{StaticResource Brush.Divider}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <DockPanel>
                            <Button
                                Width="26"
                                Height="26"
                                Padding="0"
                                Command="{Binding CloseDeviceDrawerCommand}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Btn.Icon}"
                                ToolTip="关闭">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Kind="Close" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource Brush.PrimaryText}"
                                    Kind="ViewListOutline" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Brush.PrimaryText}"
                                    Style="{StaticResource Text.Body}"
                                    Text="切换设备" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <views:DeviceTreeView />
                </DockPanel>
            </Border>

            <!--  覆盖式加载缓冲（选板 → 主测试页，对应设计稿 10）：半透明白底 + 旋转圈 + 板名  -->
            <Border Background="#E6F4F6FA" Visibility="{Binding IsBoardLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource Brush.Primary}"
                        Kind="Loading"
                        RenderTransformOrigin="0.5,0.5">
                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform Angle="0" />
                        </materialDesign:PackIcon.RenderTransform>
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Name="LoadSpinSb">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        RepeatBehavior="Forever"
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="LoadSpinSb" />
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource Text.Subtitle}"
                        Text="正在加载测试页" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource Font.Mono}"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Style="{StaticResource Text.Caption}"
                        Text="{Binding BoardLoadingText}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</chrome:ChromeWindow>
