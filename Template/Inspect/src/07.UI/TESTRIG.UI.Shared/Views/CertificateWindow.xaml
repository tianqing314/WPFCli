<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.CertificateWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
                     Title="证书 / 合格证"
                     TitleIcon="CertificateOutline"
                     Style="{StaticResource ChromeWindow.Style}"
                     Width="820" Height="520"
                     WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="CertGrid" Grid.Row="0" Margin="14,14,14,8" AutoGenerateColumns="False"
                  ItemsSource="{Binding Records}" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" IsReadOnly="True"
                  RowHeaderWidth="0" GridLinesVisibility="None" Background="Transparent"
                  BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序列号" Binding="{Binding DeviceSn}" Width="1.4*"/>
                <DataGridTextColumn Header="批次号" Binding="{Binding BatchNo}" Width="1*"/>
                <DataGridTextColumn Header="检验员" Binding="{Binding Operator}" Width="0.9*"/>
                <DataGridTextColumn Header="检验时间" Binding="{Binding EndTime}" Width="1.4*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Padding="14,10" Background="{StaticResource Brush.Surface2}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Status}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="刷新列表" Width="96" Height="34" Style="{StaticResource Btn.Secondary}"
                            Margin="0,0,10,0" Command="{Binding LoadCommand}"/>
                    <Button Content="生成合格证" Width="120" Height="34" Style="{StaticResource Btn.Primary}"
                            IsDefault="True" Command="{Binding GenerateCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=CertGrid}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</chrome:ChromeWindow>
