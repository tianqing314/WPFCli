<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.UpdateWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
                     xmlns:views="clr-namespace:TESTRIG.UI.Shared.Views"
                     Title="在线升级"
                     TitleIcon="CloudDownloadOutline"
                     Style="{StaticResource ChromeWindow.Style}"
                     Width="460" SizeToContent="Height"
                     CanMaximize="False"
                     ResizeMode="NoResize"
                     ShowInTaskbar="False"
                     WindowStartupLocation="CenterOwner">
    <chrome:ChromeWindow.Resources>
        <views:ProgressToWidthConverter x:Key="ProgressToWidth" />
    </chrome:ChromeWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,18">
            <!-- 版本变化 -->
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="4" Background="{StaticResource Brush.PrimaryPale}"
                        BorderBrush="#CFE0FC" BorderThickness="1">
                    <materialDesign:PackIcon Width="24" Height="24" Kind="CloudDownloadOutline"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{StaticResource Brush.Primary}"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="发现新版本" Style="{StaticResource Text.Subtitle}"/>
                        <!-- 强制更新标记 -->
                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource Brush.DangerPale}"
                                Visibility="{Binding IsMandatory, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="强制更新" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Danger}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                                   Foreground="{StaticResource Brush.TextMuted}" Text="{Binding CurrentVersionText}"/>
                        <materialDesign:PackIcon Width="14" Height="14" Margin="7,0" VerticalAlignment="Center"
                                                 Foreground="{StaticResource Brush.TextMuted}" Kind="ArrowRight"/>
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.PrimaryText}" Text="{Binding NewVersionText}"/>
                        <TextBlock Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="{Binding SizeText}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 更新说明 -->
            <Border Margin="0,14,0,0" Padding="12,10" Background="{StaticResource Brush.Surface2}"
                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="3"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                    <TextBlock FontSize="12.5" LineHeight="20" Foreground="{StaticResource Brush.TextWeak}"
                               Text="{Binding Notes}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- 测试中拦截提示 -->
            <Border Margin="0,12,0,0" Padding="11,8" Background="{StaticResource Brush.WarnPale}"
                    BorderBrush="#F4D99A" BorderThickness="1" CornerRadius="3"
                    Visibility="{Binding IsBlockedByTest, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="15" Height="15" VerticalAlignment="Center"
                                             Foreground="{StaticResource Brush.Warn}" Kind="AlertOutline"/>
                    <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="#8A6209"
                               Text="测试运行中，请先停止测试再安装更新。"/>
                </StackPanel>
            </Border>

            <!-- 下载进度 -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextWeak}" Text="{Binding ProgressText}"/>
                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Brush.PrimaryText}"
                               Text="{Binding Progress, StringFormat={}{0:P0}}"/>
                </Grid>
                <!-- 硬朗风进度条：方形轨道 + 品牌蓝 -->
                <Border Margin="0,7,0,0" Height="8" Background="{StaticResource Brush.WaitBg}" CornerRadius="2">
                    <Border HorizontalAlignment="Left" Background="{StaticResource Brush.Primary}" CornerRadius="2">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressToWidth}">
                                <Binding Path="Progress"/>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=Border, AncestorLevel=2}"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
            </StackPanel>

            <!-- 错误信息 -->
            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Brush.Danger}"
                       Text="{Binding Error}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="1" Padding="20,12" Background="{StaticResource Brush.Surface2}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="暂 不" Width="96" Height="36" Style="{StaticResource Btn.Secondary}"
                        Click="Later_Click"
                        Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}"/>
                <Button Margin="10,0,0,0" Width="128" Height="36" Style="{StaticResource Btn.Primary}"
                        Command="{Binding UpdateNowCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="17" Height="17" VerticalAlignment="Center" Kind="CloudDownloadOutline"/>
                        <TextBlock Margin="6,0,0,0" Text="{Binding ActionText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</chrome:ChromeWindow>
