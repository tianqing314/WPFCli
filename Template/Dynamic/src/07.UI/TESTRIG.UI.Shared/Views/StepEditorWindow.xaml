<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.StepEditorWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
                     xmlns:vm="clr-namespace:TESTRIG.UI.Shared.ViewModels"
                     d:DataContext="{d:DesignInstance vm:StepEditorViewModel}"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     mc:Ignorable="d"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     Title="编辑测试项"
                     TitleIcon="Pencil"
                     Style="{StaticResource ChromeWindow.Style}"
                     Width="660" Height="720"
                     CanMaximize="True"
                     ShowInTaskbar="False"
                     WindowStartupLocation="CenterOwner">
    <Grid Margin="16" Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 基本信息 -->
        <materialDesign:Card Grid.Row="0" Style="{StaticResource Card.Std}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Key" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="{StaticResource Brush.TextWeak}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,14,8" Text="{Binding Step.Key, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource Font.Mono}"
                         materialDesign:HintAssist.Hint="唯一标识（旧 Entry）"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Kind" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="{StaticResource Brush.TextWeak}"/>
                <!-- 可编辑下拉：从已注册处理器选，也允许保留原值 -->
                <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" IsEditable="True"
                          ItemsSource="{Binding AvailableKinds}" Text="{Binding Step.Kind, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:HintAssist.Hint="处理器类型"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="{StaticResource Brush.TextWeak}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" Text="{Binding Step.Name, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="显示名"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="描述" VerticalAlignment="Top" Margin="0,4,10,0" Foreground="{StaticResource Brush.TextWeak}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Step.Description, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="4" VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="测试项描述（操作员可读）"/>
            </Grid>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 判定条件（行内可编辑） -->
                <materialDesign:Card Style="{StaticResource Card.Std}" Padding="12,8" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                                        ToolTipService.InitialShowDelay="200">
                                <StackPanel.ToolTip>
                                    <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                               Text="对本测试项测量值的合格判定。类型：Range=落在[下限,上限]区间；Value=数值等于期望；Text=文本等于期望。可配多条，需全部通过才判 PASS。留空则不判定、只记录数据（占位项）。"/>
                                </StackPanel.ToolTip>
                                <Border Width="3" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Background="{StaticResource Brush.Primary}" CornerRadius="1"/>
                                <TextBlock Text="判定条件" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="InformationOutline" Width="15" Height="15" Margin="5,0,0,0"
                                                         VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Secondary}" Height="28" Padding="10,0" Command="{Binding AddConditionCommand}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/><TextBlock Text="新增条件" Margin="4,0,0,0"/></StackPanel>
                            </Button>
                        </DockPanel>
                        <!-- 表头 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="类型" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="2" Text="下限" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="3" Text="上限" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="4" Text="期望" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="5" Text="单位" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Step.Conditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConditionEditModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Margin="0,0,4,0"
                                                  ItemsSource="{Binding DataContext.ConditionKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="3" Margin="0,0,4,0" Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="4" Margin="0,0,4,0" Text="{Binding Expected, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="5" Margin="0,0,4,0" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="6" Width="28" Height="28" Padding="0" Style="{StaticResource Btn.Icon}" ToolTip="删除该条件"
                                                Command="{Binding DataContext.DeleteConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="{StaticResource Brush.Danger}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Range 用下限/上限；Value/Text 用期望值。空行留空即可。" Style="{StaticResource Text.Caption}" Margin="2,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 参数（行内可编辑） -->
                <materialDesign:Card Style="{StaticResource Card.Std}" Padding="12,8" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                                        ToolTipService.InitialShowDelay="200">
                                <StackPanel.ToolTip>
                                    <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                               Text="传给处理器的业务输入（名/值/单位），处理器用 ctx.Parameter(&quot;名&quot;) 读取。例：BoardType(板型)、AD(倍数 1,2,4,8,16)、采集频率、温湿度计SN1。是否被用取决于所选 Kind 的处理器是否读它。"/>
                                </StackPanel.ToolTip>
                                <Border Width="3" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Background="{StaticResource Brush.Primary}" CornerRadius="1"/>
                                <TextBlock Text="参数" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="InformationOutline" Width="15" Height="15" Margin="5,0,0,0"
                                                         VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Secondary}" Height="28" Padding="10,0" Command="{Binding AddParameterCommand}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/><TextBlock Text="新增参数" Margin="4,0,0,0"/></StackPanel>
                            </Button>
                        </DockPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="1" Text="值" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="2" Text="单位" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Step.Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ParameterEditModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="3" Width="28" Height="28" Padding="0" Style="{StaticResource Btn.Icon}" ToolTip="删除该参数"
                                                Command="{Binding DataContext.DeleteParameterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="{StaticResource Brush.Danger}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 设置项（行内可编辑） -->
                <materialDesign:Card Style="{StaticResource Card.Std}" Padding="12,8" Margin="0,0,0,2">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                                        ToolTipService.InitialShowDelay="200">
                                <StackPanel.ToolTip>
                                    <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                               Text="处理器接线/开关配置（键/值），处理器用 ctx.Setting(&quot;键&quot;) 读取，用来在不改代码下参数化同一处理器。例：Relay(继电器组)、Gear(档位)、Point/Channel(测量点/通道)、Mode(模式)。是否生效取决于所选 Kind 的处理器读了哪些键；读不到走默认值。"/>
                                </StackPanel.ToolTip>
                                <Border Width="3" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Background="{StaticResource Brush.Primary}" CornerRadius="1"/>
                                <TextBlock Text="设置项（Settings）" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="InformationOutline" Width="15" Height="15" Margin="5,0,0,0"
                                                         VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Secondary}" Height="28" Padding="10,0" Command="{Binding AddSettingCommand}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/><TextBlock Text="新增设置项" Margin="4,0,0,0"/></StackPanel>
                            </Button>
                        </DockPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="键" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                            <TextBlock Grid.Column="1" Text="值" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextWeak}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Step.Settings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingEditModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="2" Width="28" Height="28" Padding="0" Style="{StaticResource Btn.Icon}" ToolTip="删除该设置项"
                                                Command="{Binding DataContext.DeleteSettingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="{StaticResource Brush.Danger}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="18,0" Command="{Binding CancelCommand}" Content="取消"/>
            <Button Style="{StaticResource Btn.Primary}" Height="34" Padding="20,0" Margin="10,0,0,0" Command="{Binding ConfirmCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center"/>
                    <TextBlock Text="确定" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
