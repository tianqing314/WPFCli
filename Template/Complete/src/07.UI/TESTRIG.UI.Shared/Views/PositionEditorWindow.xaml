<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.PositionEditorWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
                     xmlns:vm="clr-namespace:TESTRIG.UI.Shared.ViewModels"
                     d:DataContext="{d:DesignInstance vm:PositionEditorViewModel}"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     mc:Ignorable="d"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     Title="编辑号位"
                     TitleIcon="Chip"
                     Style="{StaticResource ChromeWindow.Style}"
                     Width="460" Height="560"
                     CanMaximize="False"
                     ShowInTaskbar="False"
                     WindowStartupLocation="CenterOwner">
    <chrome:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </chrome:ChromeWindow.Resources>

    <Grid Margin="16" Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 号位基本 -->
        <materialDesign:Card Grid.Row="0" Style="{StaticResource Card.Std}" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="序号" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextWeak}"/>
                <TextBox Grid.Column="1" Margin="0,0,16,0" Text="{Binding Position.Index, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2" Text="名称" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextWeak}"/>
                <TextBox Grid.Column="3" Text="{Binding Position.Name, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="如 1号位"/>
            </Grid>
        </materialDesign:Card>

        <!-- 连接端点 -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource Card.Std}" Padding="14,12" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="3" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Background="{StaticResource Brush.Primary}" CornerRadius="1"/>
                    <TextBlock Text="连接端点" Style="{StaticResource Text.Subtitle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="通讯方式" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextWeak}"/>
                    <ComboBox Width="160" ItemsSource="{Binding CommKinds}" SelectedItem="{Binding CommKind}"/>
                </StackPanel>

                <!-- 网络 -->
                <StackPanel Visibility="{Binding IsEthernet, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="1" Margin="0,0,12,0" FontFamily="{StaticResource Font.Mono}" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="192.168.x.x"/>
                        <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="3" FontFamily="{StaticResource Font.Mono}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>

                <!-- 串口 -->
                <StackPanel Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="物理链路" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="1" Text="{Binding PhysicalLink, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="串口位标识（COM 号运行时匹配）"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="波特率" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="1" Margin="0,0,12,0" Text="{Binding Baud, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="2" Text="数据位" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="3" Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="停止位" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <ComboBox Grid.Column="1" Margin="0,0,12,0" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}"/>
                        <TextBlock Grid.Column="2" Text="校验" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}"/>
                    </Grid>
                </StackPanel>

                <!-- USB -->
                <StackPanel Visibility="{Binding IsUsb, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="物理链路" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="1" Text="{Binding PhysicalLink, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="USB 端口链，如 1-1.1.4"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="VID" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="1" Margin="0,0,12,0" FontFamily="{StaticResource Font.Mono}" Text="{Binding Vid, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="十六进制 如 2E19"/>
                        <TextBlock Grid.Column="2" Text="PID" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}"/>
                        <TextBox Grid.Column="3" FontFamily="{StaticResource Font.Mono}" Text="{Binding Pid, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="十六进制 如 0001"/>
                    </Grid>
                    <TextBlock Text="VID/PID 十六进制输入（可带 0x 前缀），底层按数值存储。" Style="{StaticResource Text.Caption}" Margin="2,2,0,0"/>
                </StackPanel>

                <TextBlock Text="选「无」则该号位不带默认端点，由连接配置页运行时提供。" Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.TextWeak}" Margin="2,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="18,0" Command="{Binding CancelCommand}" Content="取消"/>
            <Button Style="{StaticResource Btn.Primary}" Height="34" Padding="20,0" Margin="10,0,0,0" Command="{Binding ConfirmCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center"/>
                    <TextBlock Text="确定" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
