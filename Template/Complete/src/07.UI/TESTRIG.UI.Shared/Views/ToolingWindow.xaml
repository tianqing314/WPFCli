<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.ToolingWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
                     Title="工装 / 治具管理"
                     TitleIcon="WrenchOutline"
                     Style="{StaticResource ChromeWindow.Style}"
                     Width="860" Height="560"
                     WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ToolingGrid" Grid.Row="0" Margin="14,14,14,8" AutoGenerateColumns="False"
                  ItemsSource="{Binding Items}" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" HeadersVisibility="Column"
                  RowHeaderWidth="0" GridLinesVisibility="None" Background="Transparent"
                  BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                <DataGridTextColumn Header="序列号" Binding="{Binding SerialNo, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="0.8*"/>
                <DataGridTextColumn Header="校准到期" Binding="{Binding CalibrationDue, UpdateSourceTrigger=PropertyChanged}" Width="0.9*"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Padding="14,10" Background="{StaticResource Brush.Surface2}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Status}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="新增" Width="88" Height="34" Style="{StaticResource Btn.Secondary}"
                            Margin="0,0,10,0" Command="{Binding AddCommand}"/>
                    <Button Content="删除" Width="88" Height="34" Style="{StaticResource Btn.Secondary}"
                            Margin="0,0,10,0" Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=ToolingGrid}"/>
                    <Button Content="保 存" Width="96" Height="34" Style="{StaticResource Btn.Primary}"
                            IsDefault="True" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</chrome:ChromeWindow>
