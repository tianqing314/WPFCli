<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.Dialogs.MessageDialogWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
                     Title="提示"
                     TitleIcon="InformationOutline"
                     Style="{StaticResource ChromeWindow.Style}"
                     Width="420" SizeToContent="Height"
                     CanMaximize="False"
                     ResizeMode="NoResize"
                     ShowInTaskbar="False"
                     WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="22,20,22,18" Orientation="Horizontal">
            <Border x:Name="IconBox" Width="40" Height="40" CornerRadius="3"
                    Background="{StaticResource Brush.PrimaryPale}" VerticalAlignment="Top">
                <materialDesign:PackIcon x:Name="DlgIcon" Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Kind="InformationOutline" Foreground="{StaticResource Brush.Primary}"/>
            </Border>
            <TextBlock x:Name="MsgText" Margin="14,0,0,0" MaxWidth="300" TextWrapping="Wrap"
                       VerticalAlignment="Center" LineHeight="22" Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.TextWeak}"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="20,12" Background="{StaticResource Brush.Surface2}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="取 消" Width="96" Height="36" Style="{StaticResource Btn.Secondary}"
                        Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Content="确 认" Width="96" Height="36" Style="{StaticResource Btn.Primary}"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</chrome:ChromeWindow>
