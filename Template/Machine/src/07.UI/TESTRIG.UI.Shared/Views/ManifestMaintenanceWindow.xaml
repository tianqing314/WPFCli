<chrome:ChromeWindow
    x:Class="TESTRIG.UI.Shared.Views.ManifestMaintenanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:TESTRIG.UI.Shared.Views"
    xmlns:vm="clr-namespace:TESTRIG.UI.Shared.ViewModels"
    Title="TESTRIG / 测试项 维护"
    Width="1300"
    Height="860"
    d:DataContext="{d:DesignInstance vm:ManifestMaintenanceViewModel}"
    CanMaximize="True"
    Style="{StaticResource ChromeWindow.Style}"
    TitleIcon="ClipboardEditOutline"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <chrome:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:SameRefToTrueConverter x:Key="SameRefToTrue" />
        <Style
            x:Key="Fld"
            BasedOn="{StaticResource {x:Type ComboBox}}"
            TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        </Style>
        <Style
            x:Key="FldTb"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        </Style>
    </chrome:ChromeWindow.Resources>

    <Grid Margin="12" Background="{StaticResource Brush.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：TESTRIG 列表  -->
        <materialDesign:Card
            Grid.Column="0"
            Margin="0,0,10,0"
            Padding="0"
            Style="{StaticResource Card.Std}">
            <DockPanel>
                <Border
                    Padding="12,10"
                    Background="{StaticResource Brush.PrimaryPale}"
                    DockPanel.Dock="Top">
                    <DockPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Subtitle}"
                            Text="TESTRIG 列表" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Height="30"
                                Padding="10,0"
                                Command="{Binding NewManifestCommand}"
                                Style="{StaticResource Btn.Secondary}"
                                ToolTip="新增 TESTRIG">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="Plus" />
                                    <TextBlock Margin="4,0,0,0" Text="新增" />
                                </StackPanel>
                            </Button>
                            <Button
                                Height="30"
                                Margin="6,0,0,0"
                                Padding="10,0"
                                Command="{Binding DeleteManifestCommand}"
                                IsEnabled="{Binding HasSelection}"
                                Style="{StaticResource Btn.DangerOutline}"
                                ToolTip="删除选中 TESTRIG">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="TrashCanOutline" />
                                    <TextBlock Margin="4,0,0,0" Text="删除" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!--  搜索 + 全部展开/折叠（复用登录后设备树交互）  -->
                <Border
                    Padding="10,8"
                    BorderBrush="{StaticResource Brush.Divider}"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top">
                    <DockPanel>
                        <Button
                            Width="32"
                            Height="32"
                            Margin="6,0,0,0"
                            Padding="0"
                            Background="{StaticResource Brush.PrimaryPale}"
                            Command="{Binding ToggleExpandAllCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Btn.Icon}"
                            ToolTip="展开 / 折叠 全部设备族">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Foreground="{StaticResource Brush.Primary}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="UnfoldMoreHorizontal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllExpanded}" Value="True">
                                                <Setter Property="Kind" Value="UnfoldLessHorizontal" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        <TextBox
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="搜索 设备族 / 板名 / Key"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="输入设备族、板名或 Key，模糊筛选 TESTRIG" />
                    </DockPanel>
                </Border>

                <!--  两级树：一级设备族（可展开），二级板子  -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="5,5" ItemsSource="{Binding GroupsView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ManifestGroupViewModel}">
                                <StackPanel Margin="0,1">
                                    <!--  一级：设备族行  -->
                                    <ToggleButton
                                        HorizontalAlignment="Stretch"
                                        Cursor="Hand"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                        Style="{x:Null}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border
                                                    x:Name="hd"
                                                    Padding="8,8,10,8"
                                                    Background="Transparent"
                                                    CornerRadius="3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon
                                                            Grid.Column="0"
                                                            Width="16"
                                                            Height="16"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource Brush.Primary}"
                                                            Kind="DeveloperBoard" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource Font.Mono}"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Device}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource Brush.TextWeak}"
                                                            Style="{StaticResource Text.Caption}"
                                                            Text="{Binding Items.Count, StringFormat='×{0}'}" />
                                                        <materialDesign:PackIcon
                                                            x:Name="cv"
                                                            Grid.Column="3"
                                                            Width="13"
                                                            Height="13"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource Brush.TextMuted}"
                                                            Kind="ChevronDown"
                                                            RenderTransformOrigin="0.5,0.5">
                                                            <materialDesign:PackIcon.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </materialDesign:PackIcon.RenderTransform>
                                                        </materialDesign:PackIcon>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="hd" Property="Background" Value="{StaticResource Brush.Surface2}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="cv" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!--  二级：板子列表  -->
                                    <ItemsControl
                                        Margin="10,1,0,3"
                                        ItemsSource="{Binding ItemsView}"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ManifestListItem}">
                                                <Button
                                                    MinWidth="0"
                                                    Padding="8,7"
                                                    Margin="0,1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.SelectManifestCommand, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="bd"
                                                                Padding="{TemplateBinding Padding}"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="2,0,0,0"
                                                                CornerRadius="3">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface2}" />
                                                                </Trigger>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource SameRefToTrue}">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.SelectedItem" RelativeSource="{RelativeSource AncestorType=chrome:ChromeWindow}" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PrimaryPale}" />
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <TextBlock
                                                            Foreground="{StaticResource Brush.TextWeak}"
                                                            Text="{Binding Board}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Foreground="{StaticResource Brush.TextWeak}"
                                                                Kind="Chip" />
                                                            <TextBlock
                                                                Margin="2,0,0,0"
                                                                Style="{StaticResource Text.Caption}"
                                                                Text="{Binding StepCount, StringFormat='测试项 {0}'}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            Foreground="{StaticResource Brush.TextWeak}"
                                                            Style="{StaticResource Text.Caption}"
                                                            Text="{Binding Key}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>

        <!--  右：编辑区  -->
        <Grid Grid.Column="1">
            <!--  空态（无编辑对象时显示，由 Style 的 DataTrigger 控制）  -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCurrent}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <materialDesign:PackIcon
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource Brush.Primary}"
                    Kind="ClipboardTextOutline"
                    Opacity="0.3" />
                <TextBlock
                    Margin="0,14,0,0"
                    Opacity="0.55"
                    Style="{StaticResource Text.Title}"
                    Text="从左侧选择 TESTRIG 编辑，或点「新增」" />
            </StackPanel>

            <!--  编辑器  -->
            <DockPanel Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
                <!--  底部操作条  -->
                <Border Margin="0,10,0,0" DockPanel.Dock="Bottom">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Height="36"
                            Margin="0,0,10,0"
                            Padding="18,0"
                            Command="{Binding ExportManifestCommand}"
                            Style="{StaticResource Btn.Secondary}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Export" />
                                <TextBlock Margin="6,0,0,0" Text="导出" />
                            </StackPanel>
                        </Button>
                        <Button
                            Height="36"
                            Padding="18,0"
                            Command="{Binding CancelEditCommand}"
                            Content="放弃"
                            Style="{StaticResource Btn.Secondary}" />
                        <Button
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="22,0"
                            Command="{Binding SaveManifestCommand}"
                            Style="{StaticResource Btn.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="ContentSave" />
                                <TextBlock Margin="6,0,0,0" Text="保存" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer
                    DataContext="{Binding Current}"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <!--  元信息  -->
                        <materialDesign:Card
                            Margin="0,0,0,10"
                            Padding="14,12"
                            Style="{StaticResource Card.Std}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Border
                                        Width="3"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Primary}"
                                        CornerRadius="1" />
                                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="基本信息" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,10,10"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Text="Key" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,14,10"
                                        materialDesign:HintAssist.Hint="唯一 Key，如 ConST218A_Mainboard"
                                        FontFamily="{StaticResource Font.Mono}"
                                        Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,10,10"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Text="设备族" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="菜单一级，如 ConST218A"
                                        Text="{Binding DeviceFamily, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,10,10"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Text="板名" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,14,10"
                                        materialDesign:HintAssist.Hint="菜单二级，如 主板（径向）"
                                        Text="{Binding BoardName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,10,10"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Text="描述" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="任务描述"
                                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,2,0,4"
                                    Foreground="{StaticResource Brush.TextWeak}"
                                    Style="{StaticResource Text.Caption}"
                                    Text="被检设备" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Text="名称" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Text="{Binding DutName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource Brush.TextWeak}"
                                        Text="型号" />
                                    <TextBox
                                        Grid.Column="3"
                                        materialDesign:HintAssist.Hint="一板一型号，如 560EMB；决定 DUT 驱动与落库型号"
                                        FontFamily="{StaticResource Font.Mono}"
                                        Text="{Binding DutModel, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!--  号位  -->
                        <materialDesign:Card
                            Margin="0,0,0,10"
                            Padding="12,10"
                            Style="{StaticResource Card.Std}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Border
                                            Width="3"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Brush.Primary}"
                                            CornerRadius="1" />
                                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="号位" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Height="28"
                                            Padding="10,0"
                                            Command="{Binding DataContext.AddPositionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.Secondary}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Plus" />
                                                <TextBlock Margin="4,0,0,0" Text="新增" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Height="28"
                                            Margin="6,0,0,0"
                                            Padding="10,0"
                                            Command="{Binding DataContext.EditPositionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.Secondary}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Pencil" />
                                                <TextBlock Margin="4,0,0,0" Text="编辑" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Height="28"
                                            Margin="6,0,0,0"
                                            Padding="10,0"
                                            Command="{Binding DataContext.DeletePositionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.DangerOutline}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="TrashCanOutline" />
                                                <TextBlock Margin="4,0,0,0" Text="删除" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid
                                    MinHeight="40"
                                    MaxHeight="150"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding Positions}"
                                    SelectedItem="{Binding DataContext.SelectedPosition, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <DataGrid.RowStyle>
                                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                            <EventSetter Event="MouseDoubleClick" Handler="PositionRow_DoubleClick" />
                                            <Setter Property="ToolTip" Value="双击编辑该号位（含连接端点）" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding Index}"
                                            Header="序号" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Binding="{Binding Name}"
                                            Header="名称" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding CommText}"
                                            Header="连接端点" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!--  共享设备（标准模块）  -->
                        <materialDesign:Card
                            Margin="0,0,0,10"
                            Padding="12,10"
                            Style="{StaticResource Card.Std}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Border
                                            Width="3"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Brush.Primary}"
                                            CornerRadius="1" />
                                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="共享设备（标准模块）" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource Brush.TextWeak}"
                                            Text="整机每套工装独立配置；运行/连接配置页均以此处清单为准" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Height="28"
                                            Padding="10,0"
                                            Command="{Binding DataContext.AddSharedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.Secondary}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Plus" />
                                                <TextBlock Margin="4,0,0,0" Text="新增" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Height="28"
                                            Margin="6,0,0,0"
                                            Padding="10,0"
                                            Command="{Binding DataContext.RemoveSharedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.DangerOutline}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="TrashCanOutline" />
                                                <TextBlock Margin="4,0,0,0" Text="删除" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SharedDevices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,2"
                                                    Padding="6,5"
                                                    Background="{StaticResource Brush.Surface}"
                                                    BorderBrush="{StaticResource Brush.BorderStrong}"
                                                    BorderThickness="1"
                                                CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="56"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource Brush.TextWeak}"
                                                        Text="Key" />
                                                    <TextBox
                                                        Width="90"
                                                        Style="{StaticResource FldTb}"
                                                        Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Width="44"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource Brush.TextWeak}"
                                                        Text="名称" />
                                                    <TextBox
                                                        Width="96"
                                                        Style="{StaticResource FldTb}"
                                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Width="80"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource Brush.TextWeak}"
                                                        Text="通讯库实例" />
                                                    <ComboBox
                                                        Width="150"
                                                        DisplayMemberPath="TypeName"
                                                        ItemsSource="{Binding DataContext.CommLibraries, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        SelectedValue="{Binding Model}"
                                                        SelectedValuePath="Model"
                                                        Style="{StaticResource Fld}" />
                                                    <TextBlock
                                                        Width="68"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource Brush.TextWeak}"
                                                        Text="通讯方式" />
                                                    <ComboBox
                                                        Width="82"
                                                        DisplayMemberPath="Value"
                                                        ItemsSource="{Binding LinkOptions}"
                                                        SelectedValue="{Binding Link}"
                                                        SelectedValuePath="Key"
                                                        Style="{StaticResource Fld}" />
                                                    <!--  编辑按钮：弹窗配置通讯参数（串口 波特率/数据位/停止位/校验位；网口 端口号），悬停显示当前参数  -->
                                                    <Button
                                                        Height="26"
                                                        Margin="6,0,0,0"
                                                        Padding="10,0"
                                                        Command="{Binding DataContext.EditCommParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Btn.Secondary}"
                                                        ToolTip="{Binding CommSummary}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon VerticalAlignment="Center" Kind="Pencil" />
                                                            <TextBlock Margin="4,0,0,0" Text="通讯参数" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock
                                                        Width="56"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource Brush.TextWeak}"
                                                        Text="序列号" />
                                                    <TextBox
                                                        Width="130"
                                                        Style="{StaticResource FldTb}"
                                                        ToolTip="可空：填了连接时读设备 SN 比对（不匹配即断开），不填则按 IsExist 判定"
                                                        Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </materialDesign:Card>

                        <!--  测试项  -->
                        <materialDesign:Card Padding="12,10" Style="{StaticResource Card.Std}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Border
                                            Width="3"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Brush.Primary}"
                                            CornerRadius="1" />
                                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="测试项" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Height="28"
                                            Padding="10,0"
                                            Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.Secondary}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Plus" />
                                                <TextBlock Margin="4,0,0,0" Text="新增" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Height="28"
                                            Margin="6,0,0,0"
                                            Padding="10,0"
                                            Command="{Binding DataContext.EditStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.Secondary}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Pencil" />
                                                <TextBlock Margin="4,0,0,0" Text="编辑" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Height="28"
                                            Margin="6,0,0,0"
                                            Padding="10,0"
                                            Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.DangerOutline}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="TrashCanOutline" />
                                                <TextBlock Margin="4,0,0,0" Text="删除" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Width="34"
                                            Height="28"
                                            Margin="10,0,0,0"
                                            Padding="0"
                                            Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.Secondary}"
                                            ToolTip="上移">
                                            <materialDesign:PackIcon Kind="ArrowUp" />
                                        </Button>
                                        <Button
                                            Width="34"
                                            Height="28"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource Btn.Secondary}"
                                            ToolTip="下移">
                                            <materialDesign:PackIcon Kind="ArrowDown" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid
                                    x:Name="StepsGrid"
                                    MinHeight="180"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding Steps}"
                                    SelectedItem="{Binding DataContext.SelectedStep, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <DataGrid.RowStyle>
                                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                            <EventSetter Event="MouseDoubleClick" Handler="StepRow_DoubleClick" />
                                            <Setter Property="ToolTip" Value="双击编辑该测试项" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="220"
                                            Binding="{Binding Name}"
                                            Header="名称" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Binding="{Binding Key}"
                                            FontFamily="Consolas"
                                            Header="Key" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Binding="{Binding Kind}"
                                            FontFamily="Consolas"
                                            Header="Kind" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Summary}"
                                            Header="摘要" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock
                                    Margin="2,6,0,0"
                                    Style="{StaticResource Text.Caption}"
                                    Text="双击行编辑；执行顺序 = 列表顺序，用上移/下移调整。" />
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</chrome:ChromeWindow>
