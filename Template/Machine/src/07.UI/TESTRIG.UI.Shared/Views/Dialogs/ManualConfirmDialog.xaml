<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.Dialogs.ManualConfirmDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
                     Title="人工确认"
                     TitleIcon="HandPointingUp"
                     Style="{StaticResource ChromeWindow.Style}"
                     Width="460" SizeToContent="Height"
                     CanMaximize="False"
                     ResizeMode="NoResize"
                     ShowInTaskbar="False"
                     WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,18">
            <!-- 测试项名称 -->
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="3"
                        Background="{StaticResource Brush.PrimaryPale}" VerticalAlignment="Top">
                    <materialDesign:PackIcon Width="22" Height="22"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Kind="EyeOutline" Foreground="{StaticResource Brush.Primary}"/>
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock x:Name="StepNameText" Style="{StaticResource Text.Subtitle}"
                               Foreground="{StaticResource Brush.PrimaryText}"/>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.TextMuted}" Text="请操作员按操作指引观察确认"/>
                </StackPanel>
            </StackPanel>

            <!-- 操作指引 / 说明 -->
            <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="3"
                    Background="{StaticResource Brush.Surface2}"
                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1">
                <TextBlock x:Name="DescText" TextWrapping="Wrap" LineHeight="22"
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextWeak}"/>
            </Border>

            <!-- 附图（可选：内联确认 OpenInfoImgConfirmWindow 场景） -->
            <Border x:Name="ImageBox" Margin="0,12,0,0" Padding="8" CornerRadius="3"
                    Background="{StaticResource Brush.Surface2}"
                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
                    Visibility="Collapsed">
                <Image x:Name="ConfirmImage" MaxHeight="280" Stretch="Uniform"/>
            </Border>

            <!-- 超时倒计时（可选） -->
            <TextBlock x:Name="TimeoutText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Danger}"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="20,12" Background="{StaticResource Brush.Surface2}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NgBtn" Content="不合格（NG）" Width="120" Height="36" Style="{StaticResource Btn.Danger}"
                        Margin="0,0,10,0" Click="Ng_Click"/>
                <Button x:Name="OkBtn" Content="通 过（OK）" Width="120" Height="36" Style="{StaticResource Btn.Primary}"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</chrome:ChromeWindow>
