<chrome:ChromeWindow x:Class="TESTRIG.UI.Shared.Views.CommParamsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
    xmlns:vm="clr-namespace:TESTRIG.UI.Shared.ViewModels"
    d:DataContext="{d:DesignInstance vm:CommParamsEditModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="共享设备 · 通讯参数"
    TitleIcon="Tune"
    Style="{StaticResource ChromeWindow.Style}"
    Width="460"
    Height="300"
    CanMaximize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <chrome:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </chrome:ChromeWindow.Resources>

    <Grid Margin="16" Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  通讯方式  -->
        <materialDesign:Card
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="14,12"
            Style="{StaticResource Card.Std}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Brush.TextWeak}"
                    Text="通讯方式" />
                <ComboBox
                    Width="160"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding LinkOptions}"
                    SelectedValue="{Binding Link}"
                    SelectedValuePath="Key" />
            </StackPanel>
        </materialDesign:Card>

        <!--  通讯参数  -->
        <materialDesign:Card
            Grid.Row="1"
            Padding="14,12"
            Style="{StaticResource Card.Std}">
            <StackPanel>
                <!--  串口  -->
                <StackPanel Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Text="波特率" />
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding BaudOptions}"
                            SelectedItem="{Binding Baud}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Text="数据位" />
                        <ComboBox
                            Grid.Column="3"
                            ItemsSource="{Binding DataBitsOptions}"
                            SelectedItem="{Binding DataBits}" />
                    </Grid>
                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Text="停止位" />
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding StopBitsOptions}"
                            SelectedValue="{Binding StopBits}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Text="校验位" />
                        <ComboBox
                            Grid.Column="3"
                            ItemsSource="{Binding ParityOptions}"
                            SelectedValue="{Binding Parity}" />
                    </Grid>
                </StackPanel>

                <!--  网口：只需端口号（IP 用默认，无需配置）  -->
                <StackPanel Visibility="{Binding IsEthernet, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Text="端口号" />
                        <TextBox
                            Grid.Column="1"
                            FontFamily="{StaticResource Font.Mono}"
                            Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Text="IP 使用默认（192.168.40.110），无需配置"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!--  确定 / 取消  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,14,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="88"
                Height="32"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Btn.Secondary}"
                Content="取消" />
            <Button
                Width="88"
                Height="32"
                Command="{Binding OkCommand}"
                Style="{StaticResource Btn.Primary}"
                Content="确定" />
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
