<UserControl x:Class="TESTRIG.UI.Shared.Views.TestRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TESTRIG.UI.Shared.ViewModels"
             xmlns:views="clr-namespace:TESTRIG.UI.Shared.Views"
             xmlns:chrome="clr-namespace:TESTRIG.UI.Shared.Views.Chrome"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DataContext="{d:DesignInstance vm:TestRunViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:PositionCardWidthConverter x:Key="PosCardW"/>
        <!-- 状态药丸：底色+文字色按 Status 语义切换（待测/测试中/通过/不合格/跳过·已停止） -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.WaitBg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="测试中">
                    <Setter Property="Background" Value="{StaticResource Brush.PrimaryPale}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="通过">
                    <Setter Property="Background" Value="{StaticResource Brush.SuccessPale}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="不合格">
                    <Setter Property="Background" Value="{StaticResource Brush.DangerPale}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="异常">
                    <Setter Property="Background" Value="{StaticResource Brush.DangerPale}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="测试中">
                    <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="通过">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="不合格">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="异常">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 工位分段按钮：选中=主色实心（VM 直接绑 Brush） -->
        <Style x:Key="StationButtonBase" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="#E3E7EC"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 硬朗方形开关：42x22 圆角3，滑块方形，开=品牌蓝 -->
        <Style x:Key="Toggle.Hard" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" CornerRadius="3" Background="#CDD6E4">
                            <Border x:Name="knob" Width="18" Height="18" CornerRadius="2" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.2"/></Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 连接状态方形 LED（含连接绿色光晕） -->
        <Style x:Key="Led.Halo" TargetType="Border">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="Led.Dot" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#C2C7CE"/>
        </Style>
        <!-- 连接状态 chip 外框 -->
        <Style x:Key="ConnChip" TargetType="Border">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- 单测方形按钮：浅底描边小方块，蓝色播放，悬停整块变蓝（对齐 mockup .play） -->
        <Style x:Key="Btn.PlaySquare" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pb" Background="{StaticResource Brush.Surface2}"
                                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="2">
                            <materialDesign:PackIcon x:Name="pi" Kind="Play" Width="15" Height="15"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{StaticResource Brush.Primary}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pb" Property="Background" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="pb" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="pi" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工具栏幽灵按钮（连接配置/数据查看/从PLC）：白底描边，悬停蓝 -->
        <Style x:Key="Btn.Ghost" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextWeak}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PrimaryPale}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏（两行）：① ☰板 + 连接状态 + 连接配置/数据查看 ② 上下料/工位/统计 + 批次/开始 -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Divider}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <!-- 行1 -->
                <DockPanel LastChildFill="False">
                    <!-- ☰ 板名 chip：唤出设备列表（绑主壳命令与当前板信息） -->
                    <Button DockPanel.Dock="Left" Cursor="Hand" Margin="0,0,14,0" VerticalAlignment="Center"
                            Command="{Binding DataContext.ShowDeviceDrawerCommand, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}"
                            ToolTip="点击唤出设备列表切换板子">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Padding="11,7" Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Menu" Width="18" Height="18" VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary}"/>
                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.PrimaryText}"
                                                   Text="{Binding DataContext.CurrentBoardFamily, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}"/>
                                        <TextBlock Margin="7,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" Text="·"/>
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding DataContext.CurrentBoardName, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}"/>
                                        <materialDesign:PackIcon Kind="ChevronDown" Width="13" Height="13" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="Background" Value="{StaticResource Brush.PrimaryPale}"/>
                                        <Setter TargetName="cb" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 右侧：连接配置 / 数据查看 -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding OpenDataQueryCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DatabaseSearchOutline" VerticalAlignment="Center"/><TextBlock Text="数据查看" Margin="5,0,0,0"/></StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding OpenConnectionConfigCommand}">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CogOutline" VerticalAlignment="Center"/><TextBlock Text="连接配置" Margin="5,0,0,0"/></StackPanel>
                    </Button>
                </DockPanel>

                <!-- 行2 -->
                <DockPanel LastChildFill="False" Margin="0,12,0,0">
                    <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource Brush.Divider}" Margin="12,2,12,2"/>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PassedCount}" Foreground="{StaticResource Brush.Success}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Margin="3,0,12,0"/>
                        <materialDesign:PackIcon Kind="CloseCircle" Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FailedCount}" Foreground="{StaticResource Brush.Danger}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Margin="3,0,12,0"/>
                        <materialDesign:PackIcon Kind="Refresh" Foreground="{StaticResource Brush.Warn}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RetriedCount}" Foreground="{StaticResource Brush.Warn}" FontFamily="{StaticResource Font.Mono}" Margin="3,0,12,0"/>
                        <materialDesign:PackIcon Kind="TimerOutline" Foreground="{StaticResource Brush.TextWeak}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AvgText}" Foreground="{StaticResource Brush.TextWeak}" FontFamily="{StaticResource Font.Mono}" Margin="3,0,0,0"/>
                    </StackPanel>

                    <!-- 右侧：批次号 + 开始测试 -->
                    <Button DockPanel.Dock="Right" Height="36" MinWidth="128" Style="{StaticResource Btn.Primary}"
                            Background="{StaticResource Brush.Primary}" BorderBrush="{StaticResource Brush.Primary}" Foreground="White"
                            Command="{Binding StartStopCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,7,0" Foreground="White">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon"><Setter Property="Kind" Value="PlayCircleOutline"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Kind" Value="StopCircleOutline"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding StartStopText}" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <TextBox DockPanel.Dock="Right" Width="200" Height="36" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}" Margin="8,0,0,0"
                             materialDesign:HintAssist.Hint="手动输入"
                             Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock DockPanel.Dock="Right" Text="批次号" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Brush.TextWeak}"/>
                </DockPanel>

                <!-- 行3：板卡专属工具栏扩展位。内容由 BoardToolbarExtra 决定、View 由 BoardExtrasTemplates.xaml
                     的 DataTemplate 按 VM 类型自动挑选；无扩展的板卡此处为空，工具栏与原来完全一致。 -->
                <ContentControl Content="{Binding BoardToolbarExtra}"/>
            </StackPanel>
        </Border>

        <!-- 多号位并列：≤4 均分铺满；>4 每卡固定为 4 号位宽度，底部横向滚动 -->
        <ScrollViewer Grid.Row="1" Padding="14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Positions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PositionViewModel}">
                    <materialDesign:Card Style="{StaticResource Card.Std}" Padding="0" Margin="5" ClipToBounds="True">
                        <materialDesign:Card.Width>
                            <MultiBinding Converter="{StaticResource PosCardW}">
                                <Binding RelativeSource="{RelativeSource AncestorType=ScrollViewer}" Path="ViewportWidth"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Items.Count"/>
                            </MultiBinding>
                        </materialDesign:Card.Width>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource Brush.PrimaryPale}" Padding="10,8"
                                    BorderBrush="{StaticResource Brush.Primary}" BorderThickness="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" FontWeight="SemiBold"
                                              VerticalAlignment="Center" ToolTip="勾选纳入 全自动/运行 测试"/>
                                    <!-- SN：可手动输入，留空时自动生成 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="SN :" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextWeak}" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource Font.Mono}"
                                                 Foreground="{StaticResource Brush.Primary}"
                                                 MinWidth="118" MinHeight="28" Padding="6,0"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="1"
                                                 BorderBrush="{StaticResource Brush.BorderStrong}"
                                                 Background="{StaticResource Brush.Surface}"
                                                 ToolTip="可手动输入序列号，留空则自动生成"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Steps}">
                                <DataGrid.Resources>
                                    <views:BindingProxy x:Key="StepProxy" Data="{Binding}"/>
                                </DataGrid.Resources>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <EventSetter Event="MouseDoubleClick" Handler="StepRow_DoubleClick"/>
                                        <Setter Property="ToolTip" Value="双击查看该项测试过程"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- 勾选要测的项（调试用）：未全选则本次不记录数据库；表头为全选框（三态）。固定宽度避免复选框被遮挡 -->
                                    <DataGridTemplateColumn Width="56" MinWidth="56" CanUserResize="False">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <CheckBox IsThreeState="True"
                                                          IsChecked="{Binding Data.AllStepsChecked, Source={StaticResource StepProxy}, Mode=TwoWay}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="全选 / 全不选"
                                                          IsEnabled="{Binding DataContext.CanToggleMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="勾选纳入测试；未全选则为调试运行，本次不记录数据库"
                                                          IsEnabled="{Binding DataContext.CanToggleMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="46">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="测试项" Binding="{Binding Name}" Width="*" MinWidth="96">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- 过程日志列：仅单工位显示，填充右侧空白 -->
                                    <DataGridTemplateColumn Header="过程日志" Width="2*"
                                        Visibility="{Binding Data.ShowLog, Source={StaticResource StepProxy}, Converter={StaticResource BoolToVis}}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LatestLog}" Foreground="{StaticResource Brush.TextWeak}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusPill}">
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="单测" Width="48">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="28" Height="28" HorizontalAlignment="Center">
                                                    <!-- 运行中：旋转 spinner（该测试项 Status=测试中 时显示并持续旋转） -->
                                                    <materialDesign:PackIcon Kind="Loading" Width="20" Height="20"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             RenderTransformOrigin="0.5,0.5"
                                                                             Foreground="{StaticResource Brush.Primary}">
                                                        <materialDesign:PackIcon.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </materialDesign:PackIcon.RenderTransform>
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="测试中">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard Name="SpinSb">
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <StopStoryboard BeginStoryboardName="SpinSb"/>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <!-- 未运行：方形单测按钮 -->
                                                    <Button ToolTip="单独测试该项"
                                                            Command="{Binding DataContext.SingleTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Btn.PlaySquare}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="测试中">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
