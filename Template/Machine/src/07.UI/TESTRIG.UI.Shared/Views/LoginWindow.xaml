<Window
    x:Class="TESTRIG.UI.Shared.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="TESTRIG 整机测试平台 — 登录"
    Width="1040"
    Height="620"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource Font.Default}"
    Icon="pack://application:,,,/TESTRIG.App;component/Resources/app.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <!--  浅色低反差场景：淡蓝渐变底 + 大块极淡品牌色装饰，白卡与底色仅差半档  -->
    <Border
        MouseLeftButtonDown="Card_MouseLeftButtonDown"
        BorderBrush="{StaticResource Brush.BorderStrong}"
        BorderThickness="1"
        CornerRadius="6"
        ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F7F9FC" />
                <GradientStop Offset="0.6" Color="#F0F4FB" />
                <GradientStop Offset="1" Color="#E7EFFD" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!--  装饰：右上/左下 两块极淡品牌色圆角矩形（低于 6% 不抢焦点）  -->
            <Border
                Width="420"
                Height="420"
                Margin="0,-160,-140,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#0D2F6FED"
                CornerRadius="48"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="18" />
                </Border.RenderTransform>
            </Border>
            <Border
                Width="340"
                Height="340"
                Margin="-150,0,0,-170"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#082F6FED"
                CornerRadius="40"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-12" />
                </Border.RenderTransform>
            </Border>

            <!--  左上 品牌水印  -->
            <StackPanel
                Margin="44,36,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Border
                    Width="26"
                    Height="26"
                    Background="{StaticResource Brush.PrimaryPale}"
                    BorderBrush="#CFE0FC"
                    BorderThickness="1"
                    CornerRadius="3">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Primary}"
                        Kind="MemoryArrowDown" />
                </Border>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Brush.Text}"
                    Text="TESTRIG 整机测试平台" />
            </StackPanel>

            <!--  右上 标语  -->
            <StackPanel
                Margin="0,44,48,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Brush.PrimaryText}"
                    Text="整机测试 · 全流程检测" />
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right"
                    FontSize="13"
                    Foreground="{StaticResource Brush.TextWeak}"
                    Text="产线 TESTRIG 自动测试上位机" />
            </StackPanel>

            <!--  左下 版本  -->
            <TextBlock
                Margin="44,0,0,30"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontFamily="{StaticResource Font.Mono}"
                FontSize="12"
                Foreground="{StaticResource Brush.TextMuted}"
                Text="{Binding VersionText}" />

            <!--  登录卡：与浅底同族，仅靠发丝边 + 轻浮影分层  -->
            <Border
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Divider}"
                BorderThickness="1"
                CornerRadius="5"
                ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="26"
                        Direction="270"
                        Opacity="0.10"
                        ShadowDepth="6"
                        Color="#1E325A" />
                </Border.Effect>
                <StackPanel>
                    <!--  顶部品牌蓝条  -->
                    <Border Height="5" Background="{StaticResource Brush.Primary}" />
                    <StackPanel Margin="34,28,34,26">
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{StaticResource Brush.PrimaryPale}"
                            BorderBrush="#CFE0FC"
                            BorderThickness="1"
                            CornerRadius="4">
                            <materialDesign:PackIcon
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource Brush.Primary}"
                                Kind="MemoryArrowDown" />
                        </Border>
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Text.Title}"
                            Text="TESTRIG 整机测试平台" />
                        <TextBlock
                            Margin="0,6,0,22"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource Brush.TextMuted}"
                            Style="{StaticResource Text.Caption}"
                            Text="请登录以继续" />

                        <!--  账号：可输入，亦可从近 10 人历史下拉选择（选中自动回填密码）  -->
                        <TextBlock
                            Margin="2,0,0,6"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Style="{StaticResource Text.Caption}"
                            Text="账号" />
                        <ComboBox
                            DisplayMemberPath="UserName"
                            IsEditable="True"
                            ItemsSource="{Binding History}"
                            SelectedItem="{Binding SelectedCredential}"
                            Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="2,16,0,6"
                            Foreground="{StaticResource Brush.TextWeak}"
                            Style="{StaticResource Text.Caption}"
                            Text="密码" />
                        <PasswordBox
                            x:Name="PasswordBox"
                            PasswordChanged="PasswordBox_OnPasswordChanged" />

                        <TextBlock
                            Margin="2,12,0,0"
                            Foreground="{StaticResource Brush.Danger}"
                            Style="{StaticResource Text.Caption}"
                            Text="{Binding Error}"
                            TextWrapping="Wrap" />

                        <!--  取消（左） / 登录（右）  -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Content="取 消"
                                IsCancel="True"
                                Style="{StaticResource Btn.Secondary}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding LoginCommand}"
                                Content="登 录"
                                IsDefault="True"
                                Style="{StaticResource Btn.Primary}" />
                        </Grid>

                        <!--  测试账号提示  -->
                        <Border
                            Margin="0,18,0,0"
                            Padding="11,9"
                            Background="{StaticResource Brush.WarnPale}"
                            BorderBrush="#F4D99A"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    VerticalAlignment="Top"
                                    Foreground="{StaticResource Brush.Warn}"
                                    Kind="InformationOutline" />
                                <TextBlock
                                    Width="270"
                                    Margin="7,0,0,0"
                                    FontSize="11.5"
                                    Foreground="#8A6209"
                                    Text="测试账号 admin 数据只落本地库，不上报远程。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
