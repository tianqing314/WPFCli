<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      升级器目标 .NET Framework 4.8：Win10/11 内置、单个小 exe、零额外运行时，
      与主程序（net8 自包含）解耦——主程序被整目录替换时它从 %TEMP% 独立运行。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>TESTRIG 升级器</AssemblyTitle>
    <Product>TESTRIG 整机测试平台 升级器</Product>
    <RootNamespace>TESTRIG.Updater</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
